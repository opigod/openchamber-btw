-const useBtwDestroy = (sessionRef: BtwSessionRef | null): (() => void) => {
-    const { t } = useI18n();
-    return React.useCallback(() => {
-        if (!sessionRef) return;
-        void destroyBtwSession(sessionRef).then((ok) => {
-            if (!ok) toast.error(t('chat.btw.toast.destroyFailed'));
-        });
-    }, [sessionRef, t]);
-};

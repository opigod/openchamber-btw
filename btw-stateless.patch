+import React from 'react';
+import { afterEach, beforeEach, describe, expect, mock, test } from 'bun:test';
+import { act } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { Window } from 'happy-dom';
+import { I18nProvider } from '@/lib/i18n';
+
+mock.module('@/components/ui/dialog', () => ({
+  Dialog: ({ children }: React.PropsWithChildren) => <>{children}</>,
+  DialogContent: ({ children }: React.PropsWithChildren) => <div>{children}</div>,
+  DialogDescription: ({ children }: React.PropsWithChildren) => <p>{children}</p>,
+  DialogFooter: ({ children }: React.PropsWithChildren) => <div>{children}</div>,
+  DialogHeader: ({ children }: React.PropsWithChildren) => <div>{children}</div>,
+  DialogTitle: ({ children }: React.PropsWithChildren) => <h2>{children}</h2>,
+}));
+
+mock.module('@/components/chat/MarkdownRenderer', () => ({
+  SimpleMarkdownRenderer: ({ content }: { content: string }) => <div data-markdown>{content}</div>,
+}));
+
+mock.module('@/sync/sync-context', () => ({
+  useScopedBlockingPermissions: () => [],
+  useScopedBlockingForms: () => [],
+}));
+
+type BtwInput = {
+  parentSessionId: string;
+  directory: string | null;
+  question: string;
+  runtimeKey: string;
+};
+const runCalls: BtwInput[] = [];
+const dismissCalls: string[] = [];
+const openCalls: Array<[string, string, string | null]> = [];
+const runBtwQuestion = (input: BtwInput) => {
+  runCalls.push(input);
+  return Promise.resolve();
+};
+const dismissBtw = (parentSessionId: string) => {
+  dismissCalls.push(parentSessionId);
+};
+const openBtwComposer = (parentSessionId: string, ownerKey: string, directory: string | null) => {
+  openCalls.push([parentSessionId, ownerKey, directory]);
+  return true;
+};
+mock.module('@/lib/btw', () => ({ runBtwQuestion, dismissBtw, openBtwComposer }));
+
+const { BtwDialog } = await import('./BtwDialog');
+const { useBtwStore } = await import('@/stores/useBtwStore');
+
+const PARENT = 'parent-1';
+
+let happyWindow: Window;
+let previous: Array<readonly [string, PropertyDescriptor | undefined]>;
+let root: Root;
+let container: HTMLElement;
+
+beforeEach(() => {
+  happyWindow = new Window({ url: 'http://localhost' });
+  const globals = {
+    window: happyWindow,
+    document: happyWindow.document,
+    navigator: happyWindow.navigator,
+    localStorage: happyWindow.localStorage,
+    customElements: happyWindow.customElements,
+    Node: happyWindow.Node,
+    Text: happyWindow.Text,
+    NodeList: happyWindow.NodeList,
+    Element: happyWindow.Element,
+    HTMLElement: happyWindow.HTMLElement,
+    SVGElement: happyWindow.SVGElement,
+    requestAnimationFrame: happyWindow.requestAnimationFrame.bind(happyWindow),
+    cancelAnimationFrame: happyWindow.cancelAnimationFrame.bind(happyWindow),
+    getComputedStyle: happyWindow.getComputedStyle.bind(happyWindow),
+    ResizeObserver: happyWindow.ResizeObserver,
+    MutationObserver: happyWindow.MutationObserver,
+    IS_REACT_ACT_ENVIRONMENT: true,
+  };
+  previous = Object.keys(globals).map(
+    (name) => [name, Object.getOwnPropertyDescriptor(globalThis, name)] as const,
+  );
+  for (const [name, value] of Object.entries(globals)) {
+    Object.defineProperty(globalThis, name, { configurable: true, writable: true, value });
+  }
+  container = document.createElement('div');
+  document.body.appendChild(container);
+  root = createRoot(container);
+  useBtwStore.setState({ byParent: {} });
+  runCalls.length = 0;
+  dismissCalls.length = 0;
+  openCalls.length = 0;
+});
+
+afterEach(async () => {
+  await act(async () => { root.unmount(); });
+  await happyWindow.happyDOM.abort();
+  for (const [name, descriptor] of previous) {
+    if (descriptor) Object.defineProperty(globalThis, name, descriptor);
+    else Reflect.deleteProperty(globalThis, name);
+  }
+});
+
+const render = async () => {
+  await act(async () => {
+    root.render(
+      <I18nProvider>
+        <BtwDialog parentSessionId={PARENT} ownerKey="main:parent-1" directory="/repo" />
+      </I18nProvider>,
+    );
+  });
+};
+
+const button = (text: string): HTMLButtonElement | undefined =>
+  [...container.querySelectorAll('button')].find((item) => item.textContent?.includes(text));
+
+describe('BtwDialog', () => {
+  test('compose asks through the transient runner', async () => {
+    useBtwStore.getState().openComposer(PARENT, 'main:parent-1', '/repo', 'why did step 2 fail?');
+    await render();
+
+    const textarea = container.querySelector('textarea');
+    expect(textarea?.value).toBe('why did step 2 fail?');
+    await act(async () => button('Ask')?.click());
+    expect(runCalls[0]).toMatchObject({
+      parentSessionId: PARENT,
+      ownerKey: 'main:parent-1',
+      directory: '/repo',
+      question: 'why did step 2 fail?',
+    });
+  });
+
+  test('a request owned by another composer does not open this dialog', async () => {
+    useBtwStore.getState().openComposer(PARENT, 'pinned:other', '/repo', 'why?');
+    await render();
+    expect(container.querySelector('textarea')).toBeNull();
+  });
+
+  test('running shows a cancel action that dismisses only the side question', async () => {
+    useBtwStore.getState().begin(PARENT, 'req-1', 'main:parent-1', 'why?', '/repo', 'runtime');
+    await render();
+    expect(container.textContent).toContain('why?');
+    await act(async () => button('Cancel')?.click());
+    expect(dismissCalls).toEqual([PARENT]);
+  });
+
+  test('an answered request renders markdown and copies it', async () => {
+    useBtwStore.getState().begin(PARENT, 'req-1', 'main:parent-1', 'why?', '/repo', 'runtime');
+    useBtwStore.getState().succeed(PARENT, 'req-1', 'Because the fixture was stale.', 2);
+    await render();
+    expect(container.querySelector('[data-markdown]')?.textContent).toBe('Because the fixture was stale.');
+
+    const writes: string[] = [];
+    Object.defineProperty(navigator, 'clipboard', {
+      configurable: true,
+      value: { writeText: (value: string) => { writes.push(value); return Promise.resolve(); } },
+    });
+    await act(async () => button('Copy')?.click());
+    expect(writes).toEqual(['Because the fixture was stale.']);
+  });
+
+  test('a failed request retries the same question', async () => {
+    useBtwStore.getState().begin(PARENT, 'req-1', 'main:parent-1', 'why?', '/repo', 'runtime');
+    useBtwStore.getState().fail(PARENT, 'req-1', 'timeout');
+    await render();
+    expect(container.textContent).toContain('The side question timed out. Retry.');
+    await act(async () => button('Retry')?.click());
+    expect(runCalls[0]).toMatchObject({
+      parentSessionId: PARENT,
+      ownerKey: 'main:parent-1',
+      directory: '/repo',
+      question: 'why?',
+    });
+  });
+
+  test('Ask another returns to the compose stage', async () => {
+    useBtwStore.getState().begin(PARENT, 'req-1', 'main:parent-1', 'why?', '/repo', 'runtime');
+    useBtwStore.getState().succeed(PARENT, 'req-1', 'answer', 2);
+    await render();
+    await act(async () => button('Ask another')?.click());
+    expect(openCalls).toEqual([[PARENT, 'main:parent-1', '/repo']]);
+  });
+});
diff --git a/packages/ui/src/components/chat/btw/BtwDialog.tsx b/packages/ui/src/components/chat/btw/BtwDialog.tsx
new file mode 100644
index 0000000..eefb3dc
--- /dev/null
+++ b/packages/ui/src/components/chat/btw/BtwDialog.tsx
@@ -0,0 +1,243 @@
+import React from 'react';
+import { Button } from '@/components/ui/button';
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from '@/components/ui/dialog';
+import { Icon } from '@/components/icon/Icon';
+import { Spinner } from '@/components/ui/spinner';
+import { toast } from '@/components/ui';
+import { copyTextToClipboard } from '@/lib/clipboard';
+import { SimpleMarkdownRenderer } from '@/components/chat/MarkdownRenderer';
+import { isIMECompositionEvent } from '@/lib/ime';
+import { getRuntimeKey } from '@/lib/runtime-switch';
+import { cn } from '@/lib/utils';
+import { useI18n } from '@/lib/i18n';
+import { dismissBtw, openBtwComposer, runBtwQuestion } from '@/lib/btw';
+import { useBtwStore, type BtwRequest } from '@/stores/useBtwStore';
+import { useScopedBlockingForms, useScopedBlockingPermissions } from '@/sync/sync-context';
+
+type BtwDialogProps = {
+  parentSessionId: string;
+  ownerKey: string;
+  directory: string | null;
+};
+
+const failureText = (
+  failure: NonNullable<BtwRequest['failure']>,
+  t: ReturnType<typeof useI18n>['t'],
+): string | undefined => {
+  if (failure.reason === 'empty') return t('chat.btw.error.empty');
+  if (failure.reason === 'timeout') return t('chat.btw.error.timeout');
+  if (failure.reason === 'unsupported') return t('chat.btw.error.unsupported');
+  if (failure.reason === 'session-missing') return t('chat.btw.error.sessionMissing');
+  return failure.message || t('chat.btw.error.generic');
+};
+
+const BtwDialogContent: React.FC<BtwDialogProps & { request: BtwRequest }> = ({
+  parentSessionId,
+  ownerKey,
+  directory,
+  request,
+}) => {
+  const { t } = useI18n();
+  const setDraft = useBtwStore((state) => state.setDraft);
+  const inputRef = React.useRef<HTMLTextAreaElement | null>(null);
+  const [copied, setCopied] = React.useState(false);
+
+  const permissions = useScopedBlockingPermissions(parentSessionId, directory ?? undefined);
+  const forms = useScopedBlockingForms(parentSessionId, directory ?? undefined);
+  const mainWaiting = permissions.length > 0 || forms.length > 0;
+
+  React.useEffect(() => {
+    setCopied(false);
+  }, [request.answer]);
+
+  React.useEffect(() => {
+    if (request.status !== 'compose') return;
+    const frame = window.requestAnimationFrame(() => inputRef.current?.focus());
+    return () => window.cancelAnimationFrame(frame);
+  }, [request.status]);
+
+  const close = () => dismissBtw(parentSessionId);
+
+  const submit = () => {
+    if (request.status !== 'compose') return;
+    const question = request.draft.trim();
+    if (!question) return;
+    void runBtwQuestion({
+      parentSessionId,
+      ownerKey,
+      directory,
+      question,
+      runtimeKey: getRuntimeKey(),
+    });
+  };
+
+  const retry = () => {
+    if (!request.question) return;
+    void runBtwQuestion({
+      parentSessionId,
+      ownerKey,
+      directory,
+      question: request.question,
+      runtimeKey: getRuntimeKey(),
+    });
+  };
+
+  const copyAnswer = () => {
+    if (!request.answer) return;
+    void copyTextToClipboard(request.answer).then((result) => {
+      if (result.ok) setCopied(true);
+      else toast.error(t('terminalView.toast.copyFailed'));
+    });
+  };
+
+  const failure = request.failure ? failureText(request.failure, t) : undefined;
+
+  return (
+    <Dialog open onOpenChange={(open) => { if (!open) close(); }}>
+      <DialogContent data-btw-dialog="true" className="max-w-[min(560px,calc(100vw-2rem))] gap-4">
+        <DialogHeader>
+          <DialogTitle className="flex items-center gap-2">
+            <Icon name="chat-ai-3" className="size-4 text-muted-foreground" />
+            /btw
+          </DialogTitle>
+          <DialogDescription>{t('chat.btw.description')}</DialogDescription>
+        </DialogHeader>
+
+        {mainWaiting ? (
+          <div className="rounded-md bg-[color:color-mix(in_srgb,var(--status-warning)_12%,var(--surface-background))] px-3 py-2 typography-meta text-foreground">
+            {t('chat.btw.mainWaiting')}
+          </div>
+        ) : null}
+
+        {request.status === 'compose' ? (
+          <div className="flex flex-col gap-3">
+            <textarea
+              ref={inputRef}
+              autoFocus
+              value={request.draft}
+              onChange={(event) => setDraft(parentSessionId, event.target.value)}
+              onKeyDown={(event) => {
+                if (event.key !== 'Enter' || event.shiftKey || isIMECompositionEvent(event)) return;
+                event.preventDefault();
+                submit();
+              }}
+              rows={3}
+              placeholder={t('chat.btw.draftHint')}
+              aria-label={t('chat.btw.draftHint')}
+              className="min-h-[88px] w-full resize-y rounded-lg bg-[var(--surface-background)] px-3 py-2 typography-ui-label text-foreground outline-none focus-visible:ring-1 focus-visible:ring-[var(--interactive-border)]"
+            />
+            <p className="typography-micro text-muted-foreground">{t('chat.btw.textOnly')}</p>
+          </div>
+        ) : (
+          <div className="flex flex-col gap-3">
+            <div className="rounded-lg bg-[var(--surface-background)] px-3 py-2 typography-ui-label text-foreground whitespace-pre-wrap break-words">
+              {request.question}
+            </div>
+
+            {request.status === 'running' ? (
+              <div className="flex items-center gap-2 py-1 typography-meta text-muted-foreground" role="status" aria-live="polite">
+                <Spinner className="size-4" />
+                <span>{t('chat.btw.working')}</span>
+              </div>
+            ) : null}
+
+            {request.status === 'answered' ? (
+              <div className="flex max-h-[min(55vh,520px)] flex-col gap-2 overflow-y-auto">
+                <div className="break-words">
+                  <SimpleMarkdownRenderer
+                    content={request.answer ?? ''}
+                    directory={directory}
+                    variant="assistant"
+                    className="typography-ui-label"
+                    fallbackContent={<div className="whitespace-pre-wrap">{request.answer}</div>}
+                  />
+                </div>
+                <div>
+                  <Button
+                    type="button"
+                    variant="ghost"
+                    size="sm"
+                    onClick={copyAnswer}
+                    aria-label={copied ? t('chat.btw.copied') : t('chat.btw.copy')}
+                  >
+                    <Icon name={copied ? 'check' : 'file-copy'} className="size-3.5" />
+                    {copied ? t('chat.btw.copied') : t('chat.btw.copy')}
+                  </Button>
+                </div>
+              </div>
+            ) : null}
+
+            {request.status === 'failed' ? (
+              <div className="flex flex-col gap-1 py-1" role="alert">
+                <span className="typography-meta text-[var(--status-error)] break-words">
+                  {failure || t('chat.btw.error.generic')}
+                </span>
+              </div>
+            ) : null}
+          </div>
+        )}
+
+        <DialogFooter className={cn('gap-2')}>
+          {request.status === 'compose' ? (
+            <>
+              <Button type="button" variant="ghost" size="sm" onClick={close}>
+                {t('dialog.common.actions.cancel')}
+              </Button>
+              <Button type="button" size="sm" onClick={submit} disabled={!request.draft.trim()}>
+                {t('chat.btw.ask')}
+              </Button>
+            </>
+          ) : null}
+
+          {request.status === 'running' ? (
+            <Button type="button" variant="ghost" size="sm" onClick={close}>
+              {t('dialog.common.actions.cancel')}
+            </Button>
+          ) : null}
+
+          {request.status === 'answered' ? (
+            <>
+              <Button
+                type="button"
+                variant="ghost"
+                size="sm"
+                onClick={() => openBtwComposer(parentSessionId, ownerKey, directory)}
+              >
+                {t('chat.btw.askAnother')}
+              </Button>
+              <Button type="button" size="sm" onClick={close}>
+                {t('dialog.common.actions.close')}
+              </Button>
+            </>
+          ) : null}
+
+          {request.status === 'failed' ? (
+            <>
+              <Button type="button" variant="ghost" size="sm" onClick={close}>
+                {t('dialog.common.actions.close')}
+              </Button>
+              <Button type="button" size="sm" onClick={retry}>
+                {t('chat.btw.retry')}
+              </Button>
+            </>
+          ) : null}
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+};
+
+const BtwDialogView: React.FC<BtwDialogProps> = ({ parentSessionId, ownerKey, directory }) => {
+  const request = useBtwStore((state) => state.byParent[parentSessionId]);
+  if (!request || request.ownerKey !== ownerKey) return null;
+  return <BtwDialogContent parentSessionId={parentSessionId} ownerKey={ownerKey} directory={directory} request={request} />;
+};
+
+export const BtwDialog = React.memo(BtwDialogView);
